{
  "manifest_version": 3,
  "name": "Curator 采集助手",
  "version": "1.0",
  "description": "一键采集灵感、链接和图片到您的 Curator 空间。",
  "permissions": [
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}